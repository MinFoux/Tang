def splitString(input, delim):
    i = 0
    construct = ""
    lastPoint = 0
    splitCount = 0
    split = []
    while(i <= len(input) - 1):
        if(len(delim) + i <= len(input)):
            construct = input[i:i+len(delim)]
        else:
            i = len(input) - 2
                
        if(construct == delim):
            
            splitCount += 1
            outPut = input[lastPoint:i]
            
            split.append(outPut)

            lastPoint = i + 1
            construct = ""
            i += len(delim) - 1
        
        i+=1
        
    if(splitCount >= 1):
        split.append(input[lastPoint:len(input)])

    return split

def getKeyword(input):
    keyword = ""
    for i in range(len(input)):
        if(input[i] == ':'):
            break
        keyword += input[i]
    return keyword

